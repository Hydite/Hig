{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hig",
  "version": "1.10.1",
  "identifier": "io.hig.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hig",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#f5f6f3"
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "externalBin": ["binaries/hig"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Fast, secure project archiving",
    "longDescription": "Hig creates compact encrypted archives with project-aware incremental caching.",
    "macOS": {
      "signingIdentity": "046FFD02F5F0639BF0F17CB062F490A28493178D",
      "minimumSystemVersion": "12.0"
    }
  }
}
